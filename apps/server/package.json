    "@mono/common-util": "workspace:*",
    "@socket.io/admin-ui": "^0.5.1",
    "@socket.io/redis-streams-adapter": "^0.2.2",
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
