  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@9.8.0",
  "scripts": {
    "dev": "./dev-server-with-redis.sh",
    "dev:server": "tsx watch src/index.ts | npx pino-pretty",
    "debug": "tsx --inspect-brk src/index.ts | npx pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:colima": "DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock pnpm run test",
    "typecheck": "tsc --noEmit",
    "test:load": "tsx --env-file=.env src/__test__/load-test.ts"
  },
