prometheus.exporter.self "alloy_check" { }

discovery.relabel "alloy_check" {
  targets = prometheus.exporter.self.alloy_check.targets

  rule {
    target_label = "instance"
    replacement  = sys.env("ALLOY_SERVICE_NAME")
  }

  rule {
    target_label = "alloy_hostname"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy-check"
  }
}

prometheus.scrape "alloy_check" {
  targets    = discovery.relabel.alloy_check.output
  forward_to = [prometheus.relabel.alloy_check.receiver]  

  scrape_interval = "60s"
}

prometheus.relabel "alloy_check" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "(prometheus_target_sync_length_seconds_sum|prometheus_target_scrapes_.*|prometheus_target_interval.*|prometheus_sd_discovered_targets|alloy_build.*|prometheus_remote_write_wal_samples_appended_total|process_start_time_seconds)"
    action        = "keep"
  }
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = sys.env("ALLOY_METRICS_SERVICE_URL")

    basic_auth {
      username = sys.env("ALLOY_METRICS_SERVICE_USERNAME")
      password = sys.env("ALLOY_METRICS_SERVICE_PASSWORD")
    }
  }
}

loki.write "grafana_cloud_loki" {
  endpoint {
    url = sys.env("ALLOY_LOKI_URL")

    basic_auth {
      username = sys.env("ALLOY_LOKI_USERNAME")
      password = sys.env("ALLOY_LOKI_PASSWORD")
    }
  }
}

// NodeJS stuff

discovery.docker "nodejs_backend" {
    host = "unix:///var/run/docker.sock"
    refresh_interval = "10s"
}

discovery.relabel "metrics_integrations_integrations_nodejs" {
    targets = discovery.docker.nodejs_backend.targets

    // Keep only containers for the 'backend' service
    rule {
        source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
        regex         = "backend"
        action        = "keep"
    }

    // Set the metrics path for the target
    rule {
        target_label = "__metrics_path__"
        replacement  = "/api/v1/metrics"
    }

    // Set the job label
    rule {
        target_label = "job"
        replacement  = "integrations/nodejs"
    }

    // Set the instance label to the container name for uniqueness
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)" // remove leading slash
        target_label  = "instance"
    }
}

prometheus.scrape "metrics_integrations_integrations_nodejs" {
    targets    = discovery.relabel.metrics_integrations_integrations_nodejs.output
    forward_to = [prometheus.relabel.metrics_integrations_integrations_nodejs.receiver]
}

prometheus.relabel "metrics_integrations_integrations_nodejs" {
    forward_to = [prometheus.remote_write.metrics_service.receiver]

    rule {
        source_labels = ["__name__"]
        regex         = "up|nodejs_active_handles_total|nodejs_active_requests_total|nodejs_eventloop_lag_p50_seconds|nodejs_eventloop_lag_p99_seconds|nodejs_eventloop_lag_seconds|nodejs_external_memory_bytes|nodejs_gc_duration_seconds_count|nodejs_gc_duration_seconds_sum|nodejs_heap_size_total_bytes|nodejs_heap_size_used_bytes|nodejs_heap_space_size_used_bytes|nodejs_version_info|process_cpu_seconds_total|process_cpu_system_seconds_total|process_cpu_user_seconds_total|process_resident_memory_bytes|process_start_time_seconds|matchmaking_processing_duration_seconds.*|matchmaking_jobs_total.*|matchmaking_matches_created_total.*|matchmaking_queue_entries_total.*|matchmaking_queue_exits_total.*|matchmaking_queue_duration_seconds.*|ignore_cache_health.*|global_ignore_matrix_health.*|ignore_bloom_filter_metrics.*|ignore_system_cleanup_operations_total.*|ignore_system_cleanup_duration_seconds.*|bullmq_job_count.*|captcha_verification_total.*|captcha_verification_duration_seconds.*"
        action        = "keep"
    }
}

// Docker stuff

prometheus.exporter.cadvisor "integrations_cadvisor" {
    docker_only = true
}
discovery.relabel "integrations_cadvisor" {
    targets = prometheus.exporter.cadvisor.integrations_cadvisor.targets

    rule {
        target_label = "job"
        replacement  = "integrations/docker"
    }

    rule {
        target_label = "instance"
        replacement  = sys.env("ALLOY_SERVICE_NAME")
    }
}
prometheus.scrape "integrations_cadvisor" {
    targets    = discovery.relabel.integrations_cadvisor.output
    forward_to = [prometheus.remote_write.metrics_service.receiver]
}

discovery.docker "logs_integrations_docker" {
    host             = "unix:///var/run/docker.sock"
    refresh_interval = "5s"
}
discovery.relabel "logs_integrations_docker" {
    targets = []

    rule {
        target_label = "job"
        replacement  = "integrations/docker"
    }

    rule {
        target_label = "instance"
        replacement  = sys.env("ALLOY_SERVICE_NAME")
    }

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container"
    }

    rule {
        source_labels = ["__meta_docker_container_log_stream"]
        target_label  = "stream"
    }
}
loki.source.docker "logs_integrations_docker" {
    host             = "unix:///var/run/docker.sock"
    targets          = discovery.docker.logs_integrations_docker.targets
    forward_to       = [loki.write.grafana_cloud_loki.receiver]
    relabel_rules    = discovery.relabel.logs_integrations_docker.rules
    refresh_interval = "5s"
}

// Redis stuff

discovery.relabel "integrations_dragonfly" {
    targets = [{
        __address__ = "redis:6379",
    }]

    rule {
        target_label = "job"
        replacement  = "integrations/dragonfly"
    }
    rule {
        target_label = "instance"
        replacement  = sys.env("ALLOY_SERVICE_NAME")
    }
}

prometheus.scrape "integrations_dragonfly" {
    targets    = discovery.relabel.integrations_dragonfly.output
    forward_to = [prometheus.remote_write.metrics_service.receiver]
}
