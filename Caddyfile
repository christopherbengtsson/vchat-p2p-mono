{
	email {$CADDY_EMAIL}

	# For testing to avoid rate limits
	#ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Enable debug mode
	#debug
}

{$CADDY_DOMAIN:localhost} {
	log {
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
		}
	}

	# WebRTC-optimized headers
	header {
		# Enable real-time protocol optimizations
		Connection "Upgrade"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		# Enable cross-origin for WebRTC
		Cross-Origin-Embedder-Policy "credentialless"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
	}

	route {
		# WebSocket connections for Socket.IO with optimizations
		reverse_proxy /socket.io/* {$CADDY_PROXY_ADDRESS} {
			lb_policy cookie
			# WebSocket-specific optimizations
			header_up Connection {http.request.header.Connection}
			header_up Upgrade {http.request.header.Upgrade}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# Increase timeouts for WebRTC signaling
			transport http {
				read_timeout 60s
				write_timeout 60s
				dial_timeout 10s
				keep_alive 30s
			}
		}

		reverse_proxy /api/v1/* {$CADDY_PROXY_ADDRESS} {
			# API optimizations
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 30s
				write_timeout 30s
				dial_timeout 5s
				keep_alive 15s
			}
		}

		@not_proxy {
			not path /socket.io/*
			not path /api/v1/*
		}

		respond @not_proxy 404 {
			close
		}
	}

	header {
		# Enforce HTTPS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Content Security Policy
		Content-Security-Policy
		default-src 'self';
		connect-src 'self' {$CADDY_FRONTEND_URL} wss://{$CADDY_DOMAIN} https://{$CADDY_DOMAIN};
		script-src 'self' 'unsafe-inline';
		style-src 'self' 'unsafe-inline';
		img-src 'self' data:;
		media-src 'self';
		# Prevent MIME-type sniffing
		X-Content-Type-Options nosniff
		# Prevent the site from being framed
		X-Frame-Options DENY
		# Control referrer information
		Referrer-Policy no-referrer-when-downgrade
		# Disallow stuff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Omit server information
		-Server
	}
}
