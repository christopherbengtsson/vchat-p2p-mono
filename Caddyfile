{
	email {$CADDY_EMAIL}

	# For testing to avoid rate limits
	#ca https://acme-staging-v02.api.letsencrypt.org/directory

	# Enable debug mode
	#debug

	log {
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
		}
	}
}

(cors_snippet) {
	header Access-Control-Allow-Origin "{args[0]}"
	header Access-Control-Allow-Methods "GET, POST, OPTIONS"
	header Access-Control-Allow-Headers "{header.Access-Control-Request-Headers}"
	header Access-Control-Allow-Credentials "true"

	# Handle CORS preflight requests
	@options method OPTIONS
	respond @options 204
}

(headers_snippet) {
	header {
		# Enforce HTTPS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Content Security Policy
		Content-Security-Policy
		default-src 'self';
		connect-src 'self' {$CADDY_FRONTEND_URL} wss://{$CADDY_DOMAIN} https://{$CADDY_DOMAIN};
		script-src 'self' 'unsafe-inline';
		style-src 'self' 'unsafe-inline';
		img-src 'self' data:;
		media-src 'self';
		# Prevent MIME-type sniffing
		X-Content-Type-Options nosniff
		# Prevent the site from being framed
		X-Frame-Options DENY
		# Control referrer information
		Referrer-Policy no-referrer-when-downgrade
		# Disallow stuff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Omit server information
		-Server
	}
}

captcha.{$CADDY_DOMAIN:localhost} {
	import headers_snippet
	import cors_snippet "{$CADDY_FRONTEND_URL}"

	reverse_proxy {$CADDY_CAP_PROXY_ADDRESS}
}

{$CADDY_DOMAIN:localhost} {
	import headers_snippet

	route {
		# Socket.IO handles its own CORS - don't add Caddy CORS headers
		reverse_proxy /socket.io/* {$CADDY_BE_PROXY_ADDRESS} {
			lb_policy cookie
		}

		# API routes need Caddy CORS headers
		import cors_snippet "{$CADDY_FRONTEND_URL}"
		reverse_proxy /api/v1/* {$CADDY_BE_PROXY_ADDRESS}

		@not_proxy {
			not path /socket.io/*
			not path /api/v1/*
		}

		respond @not_proxy 404 {
			close
		}
	}

}
